<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SovaApps</title>
<style>
:root {
  --bg-main: #0a0a0e;
  --bg-panel: #12121a;
  --bg-card: #1a1a24;
  --bg-input: #1e1e28;
  --text-main: #ffffff;
  --text-muted: #8a8a9e;
  --accent-purple: #8b5cf6;
  --accent-purple-hover: #7c3aed;
  --border: #2a2a35;
  --radius: 16px;
  --star-color: #fbbf24;
  --star-empty: #3f3f4e;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

body {
  background: var(--bg-main);
  color: var(--text-main);
  min-height: 100vh;
  display: flex;
  justify-content: center;
  padding: 20px;
}

.store-container {
  width: 100%;
  max-width: 1000px;
  background: var(--bg-panel);
  border-radius: 24px;
  padding: 24px;
  border: 1px solid var(--border);
}

header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 30px;
}

.logo-area {
  display: flex;
  align-items: center;
  gap: 16px;
}

.logo-icon {
  width: 50px;
  height: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32px;
  background: var(--accent-purple);
  border-radius: 14px;
  box-shadow: 0 0 20px rgba(139, 92, 246, .4);
}

.logo-text h1 {
  font-size: 24px;
  font-weight: 700;
  margin-bottom: 4px;
}

.logo-text p {
  font-size: 13px;
  color: var(--text-muted);
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 250px;
  padding: 10px 16px;
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: 12px;
}

.search-bar span {
  color: var(--text-muted);
  font-size: 14px;
}

.search-bar input {
  width: 100%;
  border: none;
  outline: none;
  background: transparent;
  color: var(--text-main);
  font-size: 14px;
}

.cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 20px;
  margin-bottom: 20px;
}

.game-card {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
}

.card-banner {
  position: relative;
  height: 180px;
  display: flex;
  align-items: center;
  padding: 24px;
}

.banner-visual {
  background: linear-gradient(135deg, #4c1d95 0%, #1e1b4b 100%);
}

.banner-storka {
  background: linear-gradient(135deg, #27272a 0%, #09090b 100%);
}

.banner-owl {
  position: absolute;
  right: 20px;
  bottom: -10px;
  z-index: 1;
  font-size: 80px;
  opacity: .8;
  filter: drop-shadow(0 0 15px rgba(255,255,255,.2));
}

.banner-content {
  position: relative;
  z-index: 2;
  max-width: 70%;
}

.banner-content h2 {
  margin-bottom: 4px;
  font-size: 24px;
  font-weight: 800;
}

.subtitle {
  margin-bottom: 12px;
  font-size: 12px;
  color: rgba(255,255,255,.7);
}

.feature-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.feature-list li {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: rgba(255,255,255,.9);
}

.feature-list li::before {
  content: "✔";
  color: var(--accent-purple);
  font-size: 10px;
}

.card-info {
  display: flex;
  flex-direction: column;
  flex-grow: 1;
  padding: 20px;
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4px;
}

.title-row h3 {
  font-size: 16px;
  font-weight: 700;
}

.rating {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 13px;
  font-weight: 600;
  color: var(--star-color);
}

.desc {
  margin-bottom: 20px;
  font-size: 13px;
  color: var(--text-muted);
}

.btn-row {
  display: flex;
  gap: 8px;
  margin-top: auto;
}

.btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 12px 8px;
  border: none;
  border-radius: 10px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: .2s;
}

.btn:active {
  transform: scale(.97);
}

.btn-visual-download {
  background: var(--accent-purple);
  color: #fff;
}

.btn-visual-download:hover {
  background: var(--accent-purple-hover);
}

.btn-storka-download {
  background: #fff;
  color: #000;
}

.btn-storka-download:hover {
  background: #e4e4e7;
}

.btn-info {
  background: var(--bg-input);
  color: var(--text-main);
  border: 1px solid var(--border);
}

.btn-info:hover {
  background: var(--border);
}

.bottom-banner {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px 20px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 12px;
  font-size: 13px;
  color: var(--text-muted);
}

.bottom-banner span {
  color: var(--accent-purple);
  font-weight: bold;
}

.modal {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background: rgba(0,0,0,.8);
  backdrop-filter: blur(4px);
}

.modal.open {
  display: flex;
}

.modal-content {
  width: 100%;
  max-width: 400px;
  padding: 30px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 20px;
  animation: scaleIn .2s ease;
}

.modal-reviews {
  max-width: 500px;
  max-height: 85vh;
  overflow-y: auto;
}

@keyframes scaleIn {
  from {
    transform: scale(.95);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

.modal-content h3 {
  margin-bottom: 12px;
  font-size: 20px;
}

.modal-content p {
  margin-bottom: 20px;
  font-size: 14px;
  line-height: 1.6;
  color: var(--text-muted);
}

.close-btn {
  width: 100%;
  margin-top: 20px;
  padding: 14px;
  border: none;
  border-radius: 12px;
  background: var(--accent-purple);
  color: #fff;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
}

.modal-header-rating {
  margin-bottom: 16px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--border);
  font-size: 16px;
  font-weight: bold;
  color: var(--star-color);
}

.review-form {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 24px;
}

.stars-input {
  display: flex;
  gap: 8px;
  font-size: 28px;
  cursor: pointer;
}

.star {
  color: var(--star-empty);
  user-select: none;
  transition: color .2s, transform .1s;
}

.star.active {
  color: var(--star-color);
}

.star:hover {
  transform: scale(1.1);
}

.review-textarea {
  min-height: 80px;
  padding: 14px;
  resize: vertical;
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: 12px;
  outline: none;
  color: var(--text-main);
  font-size: 14px;
  font-family: inherit;
}

.review-textarea:focus {
  border-color: var(--accent-purple);
}

.btn-submit-review {
  align-self: flex-start;
  padding: 12px 24px;
  border: none;
  border-radius: 10px;
  background: var(--accent-purple);
  color: #fff;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: .2s;
}

.btn-submit-review:hover {
  background: var(--accent-purple-hover);
}

.reviews-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.review-item {
  padding: 16px;
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: 12px;
}

.review-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.review-header strong {
  font-size: 14px;
  color: var(--text-main);
}

.review-stars {
  font-size: 14px;
  color: var(--star-color);
}

.review-text {
  font-size: 13px;
  line-height: 1.5;
  color: var(--text-muted);
  word-break: break-word;
}

@media (max-width: 600px) {
  body {
    padding: 12px;
  }

  .store-container {
    padding: 16px;
  }

  .header-actions {
    width: 100%;
  }

  .search-bar {
    flex-grow: 1;
    width: auto;
  }

  .card-banner {
    height: 160px;
  }

  .btn {
    font-size: 12px;
    padding: 10px 4px;
  }
}
</style>
</head>
<body>

<div class="store-container">
  <header>
    <div class="logo-area">
      <div class="logo-icon">🛍️</div>
      <div class="logo-text">
        <h1>SovaApps</h1>
        <p>Выбирай, скачивай и наслаждайся!</p>
      </div>
    </div>

    <div class="header-actions">
      <div class="search-bar">
        <span>🔍</span>
        <input type="text" id="searchInput" placeholder="Поиск по SovaApps">
      </div>
    </div>
  </header>

  <div class="cards-grid" id="cardsGrid">

    <div class="game-card" data-app="SovaVisual">
      <div class="card-banner banner-visual">
        <div class="banner-owl">🦉</div>
        <div class="banner-content">
          <h2>SovaVisual</h2>
          <div class="subtitle">Лаунчер для Minecraft</div>
          <ul class="feature-list">
            <li>Быстрый запуск</li>
            <li>Все версии игры</li>
            <li>Оптимизация</li>
          </ul>
        </div>
      </div>

      <div class="card-info">
        <div class="title-row">
          <h3>SovaVisual</h3>
          <div class="rating" id="rating-SovaVisual">⭐ 0.0</div>
        </div>

        <div class="desc">Лучший лаунчер для Minecraft!</div>

        <div class="btn-row">
          <button class="btn btn-visual-download" onclick="downloadApp('SovaVisual')">⬇ Скачать</button>
          <button class="btn btn-info" onclick="openInfoModal('SovaVisual')">ⓘ Инфо</button>
          <button class="btn btn-info" onclick="openReviewModal('SovaVisual')">★ Отзывы</button>
        </div>
      </div>
    </div>

    <div class="game-card" data-app="SovaStorka">
      <div class="card-banner banner-storka">
        <div class="banner-owl" style="filter: grayscale(100%);">🦉</div>
        <div class="banner-content">
          <h2>SovaStorka</h2>
          <div class="subtitle">Шторка уведомлений для Windows</div>
          <ul class="feature-list">
            <li>Стиль смартфона</li>
            <li>Быстрый доступ</li>
            <li>Плавная анимация</li>
          </ul>
        </div>
      </div>

      <div class="card-info">
        <div class="title-row">
          <h3>SovaStorka</h3>
          <div class="rating" id="rating-SovaStorka">⭐ 0.0</div>
        </div>

        <div class="desc">Удобная шторка прямо на ПК!</div>

        <div class="btn-row">
          <button class="btn btn-storka-download" onclick="downloadApp('SovaStorka')">⬇ Скачать</button>
          <button class="btn btn-info" onclick="openInfoModal('SovaStorka')">ⓘ Инфо</button>
          <button class="btn btn-info" onclick="openReviewModal('SovaStorka')">★ Отзывы</button>
        </div>
      </div>
    </div>

  </div>

  <div class="bottom-banner">
    <span>ⓘ</span> Выбирай свой вариант и улучшай свой ПК уже сегодня!
  </div>
</div>

<div class="modal" id="infoModal">
  <div class="modal-content">
    <h3 id="infoTitle">Информация</h3>
    <p id="infoText">Текст описания...</p>
    <button class="close-btn" onclick="closeModal('infoModal')">Понятно</button>
  </div>
</div>

<div class="modal" id="reviewModal">
  <div class="modal-content modal-reviews">
    <h3 id="reviewTitle">Отзывы</h3>
    <div class="modal-header-rating" id="modalAvgRating">⭐ 0.0 (0 отзывов)</div>

    <div class="review-form">
      <div class="stars-input" id="starInput">
        <span class="star" data-value="1">★</span>
        <span class="star" data-value="2">★</span>
        <span class="star" data-value="3">★</span>
        <span class="star" data-value="4">★</span>
        <span class="star" data-value="5">★</span>
      </div>

      <textarea class="review-textarea" id="reviewText" placeholder="Напишите отзыв об этом товаре..."></textarea>

      <button class="btn-submit-review" onclick="submitReview()">Отправить</button>
    </div>

    <div class="reviews-list" id="reviewsList"></div>

    <button class="close-btn" onclick="closeModal('reviewModal')">Закрыть</button>
  </div>
</div>

<script>
const appData = {
  SovaVisual: {
    title: "SovaVisual",
    text: "SovaVisual — современный лаунчер для Minecraft. Быстрый запуск игры, поддержка версий и встроенная оптимизация для стабильной работы."
  },
  SovaStorka: {
    title: "SovaStorka",
    text: "SovaStorka — шторка уведомлений для Windows в стиле смартфона. Быстрый доступ к настройкам, уведомлениям и медиа-плееру."
  }
};

const STORAGE_KEY = "sovaAppsStats";

const defaultStats = {
  SovaVisual: {
    totalStars: 0,
    count: 0,
    reviews: []
  },
  SovaStorka: {
    totalStars: 0,
    count: 0,
    reviews: []
  }
};

let appStats = loadStats();
let currentApp = "";
let selectedRating = 0;

function loadStats() {
  try {
    const saved = JSON.parse(localStorage.getItem(STORAGE_KEY));

    if (!saved || typeof saved !== "object") {
      return structuredClone(defaultStats);
    }

    Object.keys(defaultStats).forEach(appName => {
      if (!saved[appName]) {
        saved[appName] = structuredClone(defaultStats[appName]);
      }

      if (!Array.isArray(saved[appName].reviews)) {
        saved[appName].reviews = [];
      }

      if (typeof saved[appName].totalStars !== "number") {
        saved[appName].totalStars = 0;
      }

      if (typeof saved[appName].count !== "number") {
        saved[appName].count = 0;
      }
    });

    return saved;
  } catch (error) {
    return structuredClone(defaultStats);
  }
}

function saveStats() {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(appStats));
}

function openInfoModal(appName) {
  const app = appData[appName];

  document.getElementById("infoTitle").textContent = app.title;
  document.getElementById("infoText").textContent = app.text;
  document.getElementById("infoModal").classList.add("open");
}

function openReviewModal(appName) {
  currentApp = appName;
  selectedRating = 0;

  document.getElementById("reviewTitle").textContent = "Отзывы: " + appData[appName].title;
  document.getElementById("reviewText").value = "";

  updateStars(0);
  updateRatingDisplay(appName);
  renderReviews(appName);

  document.getElementById("reviewModal").classList.add("open");
}

function closeModal(id) {
  document.getElementById(id).classList.remove("open");
}

document.querySelectorAll(".modal").forEach(modal => {
  modal.addEventListener("click", event => {
    if (event.target === modal) {
      modal.classList.remove("open");
    }
  });
});

function updateRatingDisplay(appName) {
  const stats = appStats[appName];
  const average = stats.count > 0 ? (stats.totalStars / stats.count).toFixed(1) : "0.0";

  document.getElementById("rating-" + appName).textContent = "⭐ " + average;

  if (currentApp === appName) {
    document.getElementById("modalAvgRating").textContent =
      "⭐ " + average + " (" + stats.count + " отзывов)";
  }
}

function renderReviews(appName) {
  const list = document.getElementById("reviewsList");
  list.textContent = "";

  const reviews = appStats[appName].reviews;

  if (reviews.length === 0) {
    const empty = document.createElement("p");
    empty.textContent = "Пока нет отзывов. Будьте первым!";
    empty.style.cssText = "color: var(--text-muted); font-size: 14px; text-align: center; padding: 20px 0;";
    list.appendChild(empty);
    return;
  }

  reviews.forEach(review => {
    const item = document.createElement("div");
    item.className = "review-item";

    const header = document.createElement("div");
    header.className = "review-header";

    const author = document.createElement("strong");
    author.textContent = "Пользователь";

    const stars = document.createElement("div");
    stars.className = "review-stars";
    stars.textContent = "★".repeat(review.rating) + "☆".repeat(5 - review.rating);

    const text = document.createElement("div");
    text.className = "review-text";
    text.textContent = review.text;

    header.appendChild(author);
    header.appendChild(stars);
    item.appendChild(header);
    item.appendChild(text);
    list.appendChild(item);
  });
}

document.querySelectorAll(".star").forEach(star => {
  star.addEventListener("click", () => {
    selectedRating = Number(star.dataset.value);
    updateStars(selectedRating);
  });

  star.addEventListener("mouseover", () => {
    updateStars(Number(star.dataset.value));
  });

  star.addEventListener("mouseout", () => {
    updateStars(selectedRating);
  });
});

function updateStars(value) {
  document.querySelectorAll(".star").forEach(star => {
    star.classList.toggle("active", Number(star.dataset.value) <= value);
  });
}

function submitReview() {
  const text = document.getElementById("reviewText").value.trim();

  if (!selectedRating) {
    alert("Пожалуйста, поставьте оценку.");
    return;
  }

  if (!text) {
    alert("Пожалуйста, напишите текст отзыва.");
    return;
  }

  appStats[currentApp].reviews.unshift({
    rating: selectedRating,
    text: text
  });

  appStats[currentApp].totalStars += selectedRating;
  appStats[currentApp].count += 1;

  saveStats();
  updateRatingDisplay(currentApp);
  renderReviews(currentApp);

  document.getElementById("reviewText").value = "";
  selectedRating = 0;
  updateStars(0);
}

function downloadApp(appName) {
  const content = "Спасибо за скачивание " + appName + "!\nДата: " + new Date().toLocaleString("ru-RU");
  const blob = new Blob([content], { type: "text/plain;charset=utf-8" });
  const url = URL.createObjectURL(blob);

  const link = document.createElement("a");
  link.href = url;
  link.download = appName + "_install.txt";
  document.body.appendChild(link);
  link.click();
  link.remove();

  URL.revokeObjectURL(url);
}

document.getElementById("searchInput").addEventListener("input", event => {
  const query = event.target.value.trim().toLowerCase();

  document.querySelectorAll(".game-card").forEach(card => {
    const appName = card.dataset.app.toLowerCase();
    card.style.display = appName.includes(query) ? "" : "none";
  });
});

Object.keys(appStats).forEach(updateRatingDisplay);
</script>

</body>
</html>
